{
  "name": "hushscribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based confidential speech-to-text on Privatemode TEE inference",
  "repository": "github:dhcgn/hushscribe",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test -c playwright.smoke.config.js",
    "coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/coverage-badge.mjs"
  },
  "dependencies": {
    "openai": "^7.2.0",
    "privatemode-ai": "^1.54.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^3.2.7",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
