{
  "name": "hushscribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based confidential speech-to-text on Privatemode TEE inference",
  "repository": "github:dhcgn/hushscribe",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/coverage-badge.mjs"
  },
  "dependencies": {
    "openai": "^7.2.0",
    "privatemode-ai": "^1.54.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
