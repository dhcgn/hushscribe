# Copy to .devcontainer/.env (gitignored) and fill in. Loaded into the container
# by devcontainer.json "runArgs" as a Docker --env-file: plain KEY=value lines,
# no quotes, no `export`. These are the names opencode.jsonc reads via {env:…};
# post-start.sh prints SET/MISSING per name at every container start.
BRAVE_API_KEY=
CONTEXT7_API_KEY=
GITHUB_MCP_PAT=
LYCEUM_API_KEY=
